# ==========================================
# BillGuard Server Environment Configuration
# ==========================================

PROJECT_NAME="BillGuard AI Engine"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
SECRET_KEY="development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:password123@localhost:5432/billguard"

# Google Gemini AI Configuration
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Notification integrations (Optional for AI module)
RESEND_API_KEY=""
TELEGRAM_BOT_TOKEN=""

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
