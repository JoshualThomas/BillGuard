PROJECT_NAME="BillGuard API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkeyforjwttokengenerationshouldbe32bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Asyncpg for SQLAlchemy)
DATABASE_URL="postgresql+asyncpg://postgres:password123@localhost:5432/billguard"

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# Resend Transactional Email API (Get from https://resend.com)
RESEND_API_KEY="re_sample_key"
ALERT_SENDER_EMAIL="alerts@billguard.app"

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:sample_token"

# CORS configuration (comma separated URLs)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
