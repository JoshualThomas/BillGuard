# ==========================================
# BillGuard Root Environment Configuration Template
# Duplicate this file to .env and fill in the values.
# ==========================================

# Server Configuration
PROJECT_NAME="BillGuard API"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# For local Docker: postgresql+asyncpg://postgres:password123@localhost:5432/billguard
DATABASE_URL="postgresql+asyncpg://postgres:password123@localhost:5432/billguard"

# AI / LLM Configuration (Google Gemini)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Notifications & Integrations
# Resend Email API: https://resend.com
RESEND_API_KEY="re_your_resend_api_key"
ALERT_SENDER_EMAIL="alerts@yourdomain.com"

# Telegram Bot API (from @BotFather)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="BillGuard"
